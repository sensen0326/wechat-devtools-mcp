{
  "name": "@sensen0326/wechat-devtools-mcp",
  "version": "0.1.0",
  "description": "Reusable MCP server for WeChat DevTools mini program automation and testing.",
  "author": "xzs <xuzhisen0326@163.com>",
  "license": "MIT",
  "homepage": "https://github.com/sensen0326/wechat-devtools-mcp#readme",
  "bugs": {
    "url": "https://github.com/sensen0326/wechat-devtools-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sensen0326/wechat-devtools-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wechat-devtools-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "demo",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "smoke:demo": "node scripts/smoke.mjs --projectPath demo/miniprogram --trustProject --inputSelector .input --tapSelector .button",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "wechat",
    "miniprogram",
    "wechat-devtools",
    "automation"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "miniprogram-automator": "^0.12.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
